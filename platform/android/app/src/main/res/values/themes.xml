<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AndroidDestroyRecreateDemo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Remove title/action bar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Fullscreen -->
        <item name="android:windowFullscreen">true</item>

        <!-- Allow drawing into display cutout areas -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Avoid startup preview flash -->
        <item name="android:windowDisablePreview">true</item>

        <!-- Background before renderer starts -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>